# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

subscription_id = "00000000-0000-0000-0000-000000000000"

# location    = "swedencentral"
# environment = "dev"

# Public IP allowed through the Postgres firewall, for psql from a
# workstation. Omit to allow no direct client access.
# allowed_client_ip = "203.0.113.4"

# Read the token from the environment instead of committing it:
#   export TF_VAR_entsoe_api_key="$(grep ENTSOE_API_KEY ../.env | cut -d= -f2)"
# entsoe_api_key = null

# Leave false unless the tracking server needs to be reachable from outside
# the Container Apps environment. See the authentication note in README.md.
# tracking_server_ingress_external = false
